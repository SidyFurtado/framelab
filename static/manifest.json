{
  "manifestVersion": 5,
  "id": "com.framelab.premiere",
  "name": "Framelab",
  "version": "0.3.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "framelab.mainPanel",
      "label": {
        "default": "Framelab"
      },
      "minimumSize": {
        "width": 280,
        "height": 320
      },
      "maximumSize": {
        "width": 1600,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 480
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 520
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "schemes": [
        "file"
      ],
      "extensions": [
        "",
        ".command",
        ".sh",
        ".bat",
        ".app",
        ".vbs"
      ]
    }
  }
}
